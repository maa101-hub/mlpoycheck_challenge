# Server
PORT=3000

# PostgreSQL connection string (e.g. from Neon).
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Set to "false" only for a local Postgres without TLS. Managed providers
# (Neon, Render, Supabase) need SSL, which is the default.
DATABASE_SSL=true

# Auth
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=24h

# Comma-separated list of allowed frontend origins for CORS.
# In production set this to your Vercel URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# Simulated API processing delay (ms)
API_DELAY=1500
